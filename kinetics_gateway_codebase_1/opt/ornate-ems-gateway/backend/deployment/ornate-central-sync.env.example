# Local gateway internal account (required for Central Sync loopback APIs)
CENTRAL_SYNC_LOCAL_API_PASSWORD=CHANGE_ME

# Preferred production backend auth (client credentials -> short-lived token)
CENTRAL_SYNC_GATEWAY_CLIENT_ID=CHANGE_ME
CENTRAL_SYNC_GATEWAY_CLIENT_SECRET=CHANGE_ME

# Optional static-token fallback
# CENTRAL_SYNC_GATEWAY_TOKEN=CHANGE_ME
