+    def poll_meter(self) -> dict[str, Any]:
+        if not self.config.meter.enabled:
+            return {}
+        started = time.perf_counter()
+        started_at = now_iso()
+        update = self.meter_driver.poll()
+        errors = update.get("read_errors", [])
