{
  "enabled": false,
  "identity": {
    "site_id": "kalpa",
    "gateway_id": "kalpa-ems-gateway-001",
    "organization_id": "ornate-solar",
    "schema_version": "1.0",
    "software_version": "kalpa-central-sync-v0.12"
  },
  "backend": {
    "base_url": "https://CHANGE-ME.example.com",
    "ingest_path": "/api/v1/ingest/batch",
    "gateway_token": null,
    "gateway_token_env": "CENTRAL_SYNC_GATEWAY_TOKEN",
    "verify_tls": true,
    "timeout_sec": 15.0,
    "connect_timeout_sec": 5.0,
    "source_ip": null,
    "gzip_enabled": true,
    "user_agent": "ornate-central-sync/0.12"
  },
  "local_gateway_api": {
    "base_url": "http://127.0.0.1:8000",
    "username": "internal",
    "password": null,
    "password_env": "CENTRAL_SYNC_LOCAL_API_PASSWORD",
    "token": null,
    "token_env": "CENTRAL_SYNC_LOCAL_API_TOKEN",
    "verify_tls": false
  },
  "fast_bess": {
    "enabled": true,
    "stream": "fast_bess_telemetry",
    "substream": "bess_fast",
    "poll_interval_sec": 1.0,
    "heartbeat_interval_sec": 1.0,
    "priority": "P1"
  },
  "general_assets": {
    "enabled": true,
    "stream": "general_asset_telemetry",
    "poll_interval_sec": 1.0,
    "heartbeat_interval_sec": 30.0,
    "priority": "P3",
    "catalog_dir": "generated_protocols"
  },
  "gateway_health": {
    "enabled": true,
    "stream": "gateway_health",
    "substream": "gateway",
    "poll_interval_sec": 5.0,
    "heartbeat_interval_sec": 30.0,
    "priority": "P2",
    "transition_priority": "P1"
  },
  "alarms_events": {
    "enabled": true,
    "stream": "alarms_events",
    "substream": "events",
    "poll_interval_sec": 1.0,
    "heartbeat_interval_sec": 60.0,
    "priority": "P1",
    "startup_emit_existing": false
  },
  "soc_controller": {
    "enabled": false,
    "stream": "soc_controller",
    "substream": "controller",
    "poll_interval_sec": 1.0,
    "heartbeat_interval_sec": 30.0,
    "priority": "P1",
    "source_path": null
  },
  "solis": {
    "enabled": false,
    "stream": "solis",
    "substream": "solis",
    "poll_interval_sec": 1.0,
    "heartbeat_interval_sec": 5.0,
    "priority": "P1",
    "source_path": null
  },
  "edge_ai": {
    "enabled": false,
    "stream": "edge_ai",
    "substream": "per_bess",
    "poll_interval_sec": 1.0,
    "heartbeat_interval_sec": 60.0,
    "priority": "P2",
    "source_path": null
  },
  "configuration_audit": {
    "enabled": true,
    "stream": "configuration_audit",
    "substream": "gateway",
    "poll_interval_sec": 2.0,
    "heartbeat_interval_sec": 300.0,
    "priority": "P1",
    "gateway_config_path": "configs/elecod_lineage_4pair_control_ready_template.json",
    "central_sync_config_path": "configs/central_sync_frozen_v1_3_kalpa.json"
  },
  "charge_discharge": {
    "enabled": true,
    "stream": "battery_charge_discharge_control",
    "substream": "pair_controller",
    "poll_interval_sec": 1.0,
    "heartbeat_interval_sec": 5.0,
    "priority": "P1"
  },
  "command_downlink": {
    "enabled": false,
    "poll_path": "/api/v1/commands/pending",
    "poll_interval_sec": 2.0,
    "max_commands_per_poll": 20,
    "ledger_path": "/var/lib/ornate-central-sync/command_ledger.db",
    "result_stream": "command_results",
    "result_substream": "commands",
    "result_priority": "P0",
    "stage_confirmation_phrase": "EXECUTE_STAGE_WRITE",
    "automatic_confirmation_phrase": "EXECUTE_AUTOMATIC_SEQUENCE"
  },
  "outbox": {
    "path": "/var/lib/ornate-central-sync/central_sync.db",
    "required_mount_path": null,
    "fail_if_mount_missing": false,
    "acked_retention_hours": 24,
    "dead_letter_retention_days": 30,
    "transport_attempt_retention_days": 3,
    "max_db_size_mb": 1024,
    "min_free_space_mb": 256,
    "cleanup_interval_sec": 3600.0
  },
  "overflow_archive": {
    "enabled": true,
    "archive_dir": "/mnt/ems-logs/ornate-ems-gateway/backlog_archives",
    "check_interval_sec": 2.0,
    "high_watermark_mb": 64,
    "target_watermark_mb": 32,
    "spill_min_age_sec": 60.0,
    "min_archive_free_space_mb": 1024,
    "max_messages_per_cycle": 100,
    "max_bytes_per_cycle": 8388608,
    "max_chunks_per_check": 4
  },
  "overflow_recovery": {
    "enabled": true,
    "archive_dir": "/mnt/ems-logs/ornate-ems-gateway/backlog_archives",
    "archive_glob": "central_sync_overflow_*.db",
    "scan_interval_sec": 5.0,
    "request_pause_sec": 10.0,
    "max_messages_per_request": 25,
    "max_request_bytes": 131072,
    "live_pause_sendable_count": 25,
    "live_pause_oldest_age_sec": 3.0,
    "min_available_memory_mb": 500,
    "max_load1": 2.0
  },
  "backlog_replay": {
    "enabled": false
  },
  "uploader": {
    "scan_interval_sec": 1.0,
    "coalescing_window_sec": 1.0,
    "max_messages_per_request": 100,
    "max_request_bytes": 2097152,
    "worker_count": 1,
    "fair_batching_enabled": true,
    "priority_bias_sec": 2.0,
    "candidate_scan_limit": 512,
    "backoff_initial_sec": 5.0,
    "backoff_multiplier": 2.0,
    "backoff_max_sec": 300.0,
    "jitter_percent": 0.2,
    "max_retry_after_sec": 600.0,
    "status_interval_sec": 2.0,
    "idle_sleep_sec": 0.25,
    "pause_file": "/var/lib/ornate-central-sync/uploader.pause",
    "pause_poll_sec": 1.0
  },
  "status_file": "/var/lib/ornate-central-sync/status.json",
  "log_level": "INFO"
}
