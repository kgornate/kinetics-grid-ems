+        run_status="success",
+    )
+
+    safe_stops: list[str] = []
+    service._runtime_monitor_status = (  # type: ignore[method-assign]
+        lambda pair_id, pair: _deferred_runtime_status()
+    )
+
+    def safe_stop(*args: Any, **kwargs: Any) -> dict[str, Any]:
+        safe_stops.append(str(kwargs.get("reason")))
