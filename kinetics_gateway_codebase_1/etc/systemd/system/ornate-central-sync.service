[Unit]
Description=Ornate EMS Central Sync (Kalpa v0.12, disabled by default)
After=network-online.target ornate-ems-gateway.service
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/ornate-ems-gateway/backend
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/etc/ornate-ems-gateway/ornate-ems-gateway.env
ExecStart=/opt/ornate-ems-gateway/venv/bin/python -m app.central_sync.service --config /etc/ornate-ems-gateway/central_sync.json
Restart=always
RestartSec=5
NoNewPrivileges=true
UMask=0077

[Install]
WantedBy=multi-user.target
