API_USER=internal
API_PASS=Internal@123
BASE_URL=http://127.0.0.1:8000

# Seven consecutive IST dates: 1 August through 7 August 2026.
SCHEDULE_DATES=2026-08-01,2026-08-02,2026-08-03,2026-08-04,2026-08-05,2026-08-06,2026-08-07

# Exact requested power windows.
CHARGE_START_TIME=11:15
CHARGE_STOP_TIME=12:45
DISCHARGE_START_TIME=17:00
DISCHARGE_STOP_TIME=18:45

# Four-pair power commands.
CHARGE_KW=100.0
DISCHARGE_KW=200.0
SITE_MAX_TOTAL_POWER_KW=1000.0

# Independent per-pair SOC cutoffs.
CHARGE_STOP_SOC=96.0
MIN_DISCHARGE_SOC=20.0

# Preparation begins 20 minutes early and all four pairs use the backend's
# parallel-pair support. Ready pairs start at the boundary without waiting for
# a slower pair; slow pairs can catch up for up to 10 minutes.
PREPARE_LEAD_MINUTES=20
PREPARE_MAX_WORKERS=4
START_MAX_WORKERS=4
ZERO_MAX_WORKERS=4
NORMAL_CATCHUP_MINUTES=10
MIN_REMAINING_SESSION_MINUTES=15

# Cached monitoring avoids competing with the backend's live hardware lane.
PREPARE_POLL_SECONDS=1
MONITOR_POLL_SECONDS=5
START_GUARD_SECONDS=5
STOP_GUARD_SECONDS=5
POWER_TRACK_TIMEOUT_SECONDS=120
POWER_TRACK_MIN_FRACTION=0.75
STATUS_ERROR_LIMIT=3
POWER_VIOLATION_LIMIT=3

# Refuse timed operation if the clock is unsynchronised or root free space is
# dangerously low. Scheduler state is stored on the large EMS partition.
REQUIRE_NTP_SYNC=true
ROOT_MIN_FREE_MB=512
STATE_DIR=/mnt/ems-logs/scheduler/bess-seven-day-backend-v3
LOCK_FILE=/run/bess-seven-day-backend-v3.lock

STAGE_CONFIRMATION=EXECUTE_STAGE_WRITE
ARM_PHRASE=EXECUTE_7_DAY_BACKEND_V3_SCHEDULE
