[Unit]
Description=Ornate EMS Central Sync Low-Priority Backlog Replay
After=network-online.target central-sync.service
Wants=network-online.target
RequiresMountsFor=/mnt/ems-logs

[Service]
Type=simple
User=root
WorkingDirectory=/root/kinetics-grid-ems/northbound_ems_gateway
Environment=PYTHONPATH=src
EnvironmentFile=-/etc/central-sync.env
ExecStart=/usr/bin/python3 -m nb_ems_gateway.central_sync.backlog_replayer --config configs/central_sync.json
Restart=on-failure
RestartSec=30
Nice=10
CPUQuota=20%
MemoryHigh=96M
MemoryMax=160M
TasksMax=32
StandardOutput=journal+console
StandardError=journal+console

[Install]
WantedBy=multi-user.target
