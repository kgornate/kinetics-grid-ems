{
  "enabled": true,
  "dry_run": true,
  "run_interval_sec": 5,
  "failed_retry_interval_sec": 30,
  "state_db_path": "/mnt/ems-logs/northbound_ems_gateway/ugx_uploader_state.db",
  "log_payload_preview": true,
  "ugx_server": {
    "base_url": "https://platform.uniqgrid.com",
    "endpoint_template": "/api/v1/{deviceToken}/telemetry",
    "device_token": "EMSTEST",
    "timeout_sec": 15,
    "verify_tls": true,
    "extra_headers": {}
  },
  "gateway_api": {
    "base_url": "http://127.0.0.1:8000",
    "username": "internal",
    "password": null,
    "password_env": "NB_EMS_INTERNAL_PASSWORD",
    "access_token": null,
    "access_token_env": null,
    "timeout_sec": 10
  },
  "fast_bess_upload": {
    "enabled": true,
    "db_path": "/mnt/ems-logs/northbound_ems_gateway/nb_ems_gateway.db",
    "state_key": "fast_bess_compact",
    "max_source_rows_per_cycle": 2000,
    "max_records_per_post": 500,
    "key_prefix": "",
    "include_profile_metadata": true,
    "include_quality_metadata": true,
    "value_key_format": "{bess_id}_fast_{asset}_{signal}"
  },
  "full_pcs_bms_upload": {
    "enabled": true,
    "interval_sec": 60,
    "state_key": "full_pcs_bms_snapshot",
    "max_asset_page_size": 500,
    "key_prefix": "",
    "include_quality_metadata": false,
    "value_key_format": "{bess_id}_full_{asset}_{signal}",
    "sources": {
      "external_ems_1": {
        "bess_id": "bess_1",
        "pcs_asset_id": "external_ems_1_pcs",
        "bms_asset_id": "external_ems_1_bms"
      },
      "external_ems_2": {
        "bess_id": "bess_2",
        "pcs_asset_id": "external_ems_2_pcs",
        "bms_asset_id": "external_ems_2_bms"
      }
    }
  },
  "key_aliases": {
  }
}
