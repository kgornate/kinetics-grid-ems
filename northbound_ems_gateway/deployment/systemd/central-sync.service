[Unit]
Description=Ornate EMS Central Sync Store-and-Forward Service
After=network-online.target ems-v3-gateway.service
Wants=network-online.target
RequiresMountsFor=/mnt/ems-logs

[Service]
Type=simple
User=root
WorkingDirectory=/root/kinetics-grid-ems/northbound_ems_gateway
Environment=PYTHONPATH=src
EnvironmentFile=-/etc/central-sync.env
ExecStart=/usr/bin/python3 -m nb_ems_gateway.central_sync.service --config configs/central_sync.json
Restart=always
RestartSec=5
StandardOutput=journal+console
StandardError=journal+console

[Install]
WantedBy=multi-user.target
