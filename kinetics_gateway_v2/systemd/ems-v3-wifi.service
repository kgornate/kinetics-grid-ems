[Unit]
Description=EMS Boot V3 Wi-Fi setup
After=systemd-modules-load.service network-pre.target
Wants=network-pre.target
Before=cloudflared.service
Conflicts=connman.service wpa_supplicant.service

[Service]
Type=oneshot
ExecStart=/root/northbound-ems/ems_boot_v3/scripts/imx93_wifi_v3.sh
RemainAfterExit=yes
TimeoutStartSec=240
StandardOutput=journal+console
StandardError=journal+console

[Install]
WantedBy=multi-user.target
